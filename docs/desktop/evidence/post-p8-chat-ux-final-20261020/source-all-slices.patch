+                scene.sendKeyEvent(KeyEvent(Key.Escape,KeyEventType.KeyDown));scene.sendKeyEvent(KeyEvent(Key.Escape,KeyEventType.KeyUp))
+                scene.until{!open};assertEquals(0,f.server.requestCount)
+            }finally{scene.close()}
