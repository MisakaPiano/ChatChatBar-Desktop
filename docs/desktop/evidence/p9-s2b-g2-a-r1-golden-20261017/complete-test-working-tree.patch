+            assertEquals(entry.getValue("bytes").jsonPrimitive.long,raw.size.toLong(),path)
+            assertEquals(entry.getValue("sha256").jsonPrimitive.content,DesktopDocumentIndexTransactionSyntheticFixture.hash(raw),path)
+        }
+    }
