+                assertTrue(bytes.isEmpty() || bytes.last()==10.toByte())
+                val lines=bytes.toString(Charsets.UTF_8).split('\n').dropLast(1).filter{it.isNotEmpty()}
+                assertEquals(order.jsonArray.map{it.jsonPrimitive.content},lines.map{Json.parseToJsonElement(it).jsonObject.getValue("storageId").jsonPrimitive.content})
+            }
