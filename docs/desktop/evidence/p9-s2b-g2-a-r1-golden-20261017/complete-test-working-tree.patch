+            for((path,kind) in manifest.getValue("controlKinds").jsonObject) {
+                val control=Json.parseToJsonElement(Files.readString(f.root.resolve(path))).jsonObject
+                assertEquals("CCB_DOCUMENT_INDEX_J",control.getValue("format").jsonPrimitive.content)
+                assertEquals(1,control.getValue("version").jsonPrimitive.int)
+                assertEquals(kind,control.getValue("kind"))
+                if(kind.jsonPrimitive.content!="DOMAIN")assertEquals("66666666-6666-4666-8666-666666666666",control.getValue("txId").jsonPrimitive.content)
+            }
+            for((path,order) in manifest.getValue("jsonlOrder").jsonObject) {
