+                val afterResizeScope = checkNotNull(sceneScope)
+                println("R1A_DIAGNOSTIC resizeSameScope=${beforeResizeScope === afterResizeScope} beforeScopeActive=${beforeResizeScope.isActive} afterScopeActive=${afterResizeScope.isActive} value=${range.value()} max=${range.maxValue()} distance=$distance voice=${scene.nodes().single { it.label("语音与朗读") }.boundsInRoot}")
+                var entered = false
+                var returned = false
