+class SessionScopedJobRegistry(
+    private val scope: CoroutineScope
+) {
+    private val lock = Any()
+    private val deletingSessionIds = mutableSetOf<String>()
+    private val stoppingSessionIds = mutableSetOf<String>()
+    private val cancellationMutex = Mutex()
+    private val jobsBySessionId = mutableMapOf<String, MutableSet<Job>>()
+    private val mutableActiveSessionIds = MutableStateFlow<Set<String>>(emptySet())
+    val activeSessionIds: StateFlow<Set<String>> = mutableActiveSessionIds.asStateFlow()
+
+    suspend fun <T> whileStopped(sessionId: String, recover: suspend () -> Unit, operation: suspend () -> T): T {
+        val caller = kotlinx.coroutines.currentCoroutineContext()
+        var outcome: Result<T>? = null
+        cancelAndJoin(sessionId, permanent = false) {
+            recover() // Failure retains the seal; callers cannot continue destructive work.
+            outcome = runCatching { kotlinx.coroutines.withContext(caller) { operation() } }
+        }
+        return checkNotNull(outcome).getOrThrow()
+    }
+
+    fun launch(
+        sessionId: String,
+        block: suspend CoroutineScope.() -> Unit
+    ): Job? {
+        val job = synchronized(lock) {
+            if (sessionId in deletingSessionIds || sessionId in stoppingSessionIds) return null
+            scope.launch(start = CoroutineStart.LAZY, block = block).also { job ->
+                jobsBySessionId.getOrPut(sessionId) { mutableSetOf() }.add(job)
+                mutableActiveSessionIds.value = jobsBySessionId.keys.toSet()
+            }
+        }
+        job.invokeOnCompletion {
+            synchronized(lock) {
+                jobsBySessionId[sessionId]?.let { jobs ->
+                    jobs.remove(job)
+                    if (jobs.isEmpty()) jobsBySessionId.remove(sessionId)
+                    mutableActiveSessionIds.value = jobsBySessionId.keys.toSet()
+                }
+            }
+        }
+        job.start()
+        return job
+    }
+
+    suspend fun cancelAndJoin(
+        sessionId: String,
+        permanent: Boolean = true,
+        afterDrain: suspend () -> Unit = {},
+    ) = cancellationMutex.withLock {
+        val jobs = synchronized(lock) {
+            if (permanent) deletingSessionIds.add(sessionId) else stoppingSessionIds.add(sessionId)
+            jobsBySessionId[sessionId]?.toList().orEmpty()
+        }
+        jobs.forEach(Job::cancel)
+        kotlinx.coroutines.withContext(kotlinx.coroutines.NonCancellable) {
+            jobs.forEach { it.join() }
+            afterDrain()
+            // Failed recovery stays closed; another explicit stop may finish recovery and reopen.
+            synchronized(lock) { stoppingSessionIds.remove(sessionId) }
+        }
+    }
+}
