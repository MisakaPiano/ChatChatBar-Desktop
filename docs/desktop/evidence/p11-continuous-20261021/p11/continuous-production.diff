-            expectedNodes = evidenceNodes,
-            currentNodesById = current.nodes,
-            activeNodeIds = current.state.page(sourceTier).activeNodeIds.toSet(),
-            staleNodeIds = current.state.staleSourcesByNodeId.keys,
