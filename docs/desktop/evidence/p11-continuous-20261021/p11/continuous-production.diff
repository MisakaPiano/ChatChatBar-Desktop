+        assertFails { DesktopUpdatePolicy.select(body(release("0.2.0", false), release("0.2.0", false)), "0.1.0", true) }
+        assertFails { DesktopUpdatePolicy.select("{}".toByteArray(), "0.1.0", true) }
+    }
