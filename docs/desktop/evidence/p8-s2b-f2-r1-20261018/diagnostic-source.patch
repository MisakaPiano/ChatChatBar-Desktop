+            "169.254.1.1", "192.168.0.1", "192.0.2.1", "198.18.0.1", "198.51.100.1", "203.0.113.1",
+            "224.0.0.1", "::", "::1", "fe80::1", "fc00::1", "::ffff:127.0.0.1"))
