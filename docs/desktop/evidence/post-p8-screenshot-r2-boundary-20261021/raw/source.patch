diff --git a/app/desktopApp/src/test/kotlin/com/example/chatbar/desktop/DesktopScreenshotBoundaryTest.kt b/app/desktopApp/src/test/kotlin/com/example/chatbar/desktop/DesktopScreenshotBoundaryTest.kt
