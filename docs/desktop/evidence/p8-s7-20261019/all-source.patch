diff --git a/app/desktopApp/src/main/kotlin/com/example/chatbar/desktop/DesktopVoiceArchiveHandoff.kt b/app/desktopApp/src/main/kotlin/com/example/chatbar/desktop/DesktopVoiceArchiveHandoff.kt
new file mode 100644
index 00000000..d87cb2f9
--- /dev/null
+++ b/app/desktopApp/src/main/kotlin/com/example/chatbar/desktop/DesktopVoiceArchiveHandoff.kt
@@ -0,0 +1,131 @@
+package com.example.chatbar.desktop
+
+import com.example.chatbar.data.local.entity.*
+import com.example.chatbar.data.repository.VoiceMessageRepository
+import com.example.chatbar.domain.chat.MessageAlternativeVersionPolicy
+import com.example.chatbar.domain.voice.VoiceMessageVersionPolicy
+import java.io.InputStream
+import java.io.OutputStream
+import java.nio.file.*
+import java.util.Base64
+import java.util.UUID
+import kotlinx.coroutines.*
+import kotlinx.serialization.json.Json
+
+/** Audio-only P11 port. It does not create/import a .cbsave or mutate chat/session entities.
+ * P11 owns package validation, message mapping and atomic entity replacement.
+ */
+internal class DesktopVoiceArchiveHandoff(private val store: DesktopVoiceAudioStore,
+    private val repository: VoiceMessageRepository,
+) {
+    private val json = Json { encodeDefaults = true; ignoreUnknownKeys = false }
+    internal data class Export(val voices: List<GeneratedVoiceMessage>, val sources: Map<String, Path>)
+
+    suspend fun planExport(voices: List<GeneratedVoiceMessage>, includeAudio: Boolean): Export {
+        if (!includeAudio) return Export(emptyList(), emptyMap()) // Must not read omitted audio.
+        require(voices.map { it.id }.distinct().size == voices.size)
+        val sources = linkedMapOf<String, Path>()
+        val packaged = voices.map { voice ->
+            val source = store.verify(voice.audioPath)
+            val resourceId = "audio-${UUID.randomUUID()}"
+            sources[resourceId] = source
+            voice.copy(audioPath = PREFIX + resourceId)
+        }
+        return Export(packaged, sources)
+    }
+
+    suspend fun writeVoices(plan: Export, output: OutputStream) {
+        plan.voices.forEach { voice ->
+            currentCoroutineContext().ensureActive()
+            output.write(json.encodeToString(GeneratedVoiceMessage.serializer(), voice).toByteArray(Charsets.UTF_8))
+            output.write('\n'.code)
+        }
+    }
+
+    suspend fun writeAudio(plan: Export, resourceId: String, output: OutputStream) {
+        val source = checkNotNull(plan.sources[resourceId]); store.verify(source.toString())
+        Files.newInputStream(source, LinkOption.NOFOLLOW_LINKS).use { input ->
+            val buffer = ByteArray(16384); var size = 0L
+            while (true) {
+                currentCoroutineContext().ensureActive()
+                val n = input.read(buffer); if (n < 0) break
+                check(n <= CLIP_BYTES - size); output.write(buffer, 0, n); size += n
+            }
+        }
+        store.verify(source.toString())
+    }
+
+    /** targetMessages must be normalized BEFORE changing message IDs (official copy semantics).
+     * No source path is opened: resources are supplied as bounded streams by the validated P11 reader.
+     * Reattachment is performed by shared restoreForSession(session, staged.voices, targetMessages).
+     */
+    suspend fun stage(voices: List<GeneratedVoiceMessage>, targetSession: String,
+        messageMap: Map<String, ChatMessage>, openResource: (String) -> InputStream): Staged {
+        require(voices.size <= 10_000 && voices.map { it.id }.distinct().size == voices.size)
+        val resources = voices.map { voice ->
+            require(voice.id.isNotBlank() && voice.audioPath.startsWith(PREFIX))
+            val resource = voice.audioPath.removePrefix(PREFIX)
+            require(resource.matches(Regex("[A-Za-z0-9_-]{1,128}")))
+            val target = requireNotNull(messageMap[voice.messageId]) { "语音消息缺少目标映射" }
+            require(target.sessionId == targetSession && target.role == MessageRole.ASSISTANT)
+            val versions = MessageAlternativeVersionPolicy.versions(target)
+            require(voice.messageVersionId == null || versions.any { it.id == voice.messageVersionId }) {
+                "目标消息版本必须在改 ID 前归一化并保留原版本身份"
+            }
+            resource
+        }
+        val staged = Staged()
+        try {
+            var totalBytes = 0L
+            voices.zip(resources).forEach { (voice, resource) ->
+                currentCoroutineContext().ensureActive()
+                val id = UUID.randomUUID().toString()
+                val target = messageMap.getValue(voice.messageId)
+                val audio = openResource(resource).use { input ->
+                    store.persist(targetSession, UUID.randomUUID().toString(), input) { received ->
+                        check(received <= SESSION_BYTES - totalBytes) { "本轮暂存音频超过 64 MiB；请由 P11 分批处理" }
+                    }
+                }
+                staged.paths += audio.path; totalBytes += audio.byteLength
+                staged.voices += voice.copy(id = id, sessionId = targetSession, messageId = target.id,
+                    messageVersionId = voice.messageVersionId ?: VoiceMessageVersionPolicy.inferLegacyVersionId(target, voice, null),
+                    anchorId = null, audioPath = audio.path, durationMs = audio.durationMs, byteLength = audio.byteLength,
+                    updatedAt = System.currentTimeMillis())
+            }
+            return staged
+        } catch (error: Throwable) {
+            try { staged.rollbackUnreferenced() } catch (cleanup: Throwable) { error.addSuppressed(cleanup) }
+            throw error
+        }
+    }
+
+    suspend fun stageLegacy(slot: SaveSlot, targetSession: String, messageMap: Map<String, ChatMessage>): Staged {
+        require(slot.schemaVersion in 1..7)
+        return stage(slot.voiceMessages, targetSession, messageMap) { resource ->
+            val entry = requireNotNull(slot.audioResources[resource]) { "旧存档缺少音频" }
+            require(entry.data.length <= 24 * 1024 * 1024)
+            Base64.getDecoder().wrap(entry.data.byteInputStream(Charsets.US_ASCII))
+        }
+    }
+
+    inner class Staged internal constructor() {
+        val voices = mutableListOf<GeneratedVoiceMessage>()
+        internal val paths = mutableListOf<String>()
+        /** P11 invokes after failure/cancel, including uncertain commits. Strict read failures
+         * retain every remaining file; committed references are never removed.
+         */
+        suspend fun rollbackUnreferenced() = withContext(NonCancellable) {
+            paths.toList().forEach { path ->
+                if (!repository.isAudioReferenced(path) && store.deleteIfOwned(path)) paths.remove(path)
+            }
+        }
+    }
+
+    companion object {
+        const val PREFIX = "chatbar-save-slot-audio:"
+        const val VOICES_ENTRY = "voices.jsonl"
+        const val AUDIO_DIRECTORY = "media/audio/"
+        private const val CLIP_BYTES = 16L * 1024 * 1024
+        private const val SESSION_BYTES = 64L * 1024 * 1024
+    }
+}
diff --git a/app/desktopApp/src/main/kotlin/com/example/chatbar/desktop/DesktopVoiceAudioStore.kt b/app/desktopApp/src/main/kotlin/com/example/chatbar/desktop/DesktopVoiceAudioStore.kt
new file mode 100644
index 00000000..ba4ac6ad
--- /dev/null
+++ b/app/desktopApp/src/main/kotlin/com/example/chatbar/desktop/DesktopVoiceAudioStore.kt
@@ -0,0 +1,128 @@
+package com.example.chatbar.desktop
+
+import com.example.chatbar.domain.voice.FishAudioStoredAudio
+import java.io.InputStream
+import java.nio.file.*
+import java.nio.file.attribute.BasicFileAttributes
+import java.security.MessageDigest
+import java.util.UUID
+import kotlinx.coroutines.*
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+
+/** Durable audio, never a preview directory. Unknown/changed files are preserved.
+ * No startup orphan sweep: an incomplete entity inventory is not deletion authority.
+ * Immutable UUID artifacts have a small ownership receipt; a crash between publication
+ * and entity commit leaves recoverable evidence rather than deleting uncertain audio.
+ */
+internal class DesktopVoiceAudioStore(dataRoot: Path) {
+    private val dataRoot = dataRoot.toAbsolutePath().normalize()
+    private val root = this.dataRoot.resolve("audio/generated")
+    private val mutex = Mutex()
+    private val limit = 16L * 1024 * 1024
+
+    suspend fun persist(sessionId: String, artifactId: String, input: InputStream,
+        expected: Long = -1, onBytes: (Long) -> Unit = {},
+    ): FishAudioStoredAudio = mutex.withLock { withContext(Dispatchers.IO) {
+        val dir = root.resolve(segment(sessionId))
+        ensureDirectory(dir)
+        val directoryIdentity = identity(dir)
+        val path = dir.resolve("${segment(artifactId)}.mp3")
+        check(!Files.exists(path, LinkOption.NOFOLLOW_LINKS)) { "音频身份冲突；旧文件已保留" }
+        require(expected in -1..limit)
+        val part = dir.resolve(".${UUID.randomUUID()}.part")
+        var published = false
+        var partIdentity: Any? = null
+        try {
+            var size = 0L
+            Files.newOutputStream(part, StandardOpenOption.CREATE_NEW).use { output ->
+                partIdentity = identity(part)
+                val buffer = ByteArray(16384)
+                while (true) {
+                    currentCoroutineContext().ensureActive()
+                    val count = input.read(buffer); if (count < 0) break
+                    check(count <= limit - size) { "音频超过 16 MiB" }
+                    output.write(buffer, 0, count); size += count; onBytes(size)
+                }
+            }
+            check(size > 0 && (expected < 0 || expected == size)) { "音频下载不完整" }
+            check(partIdentity == identity(part)) { "下载文件身份变化；已保留" }
+            val duration = DesktopMp3Validation.validate(part, limit, 1_800_000)
+            currentCoroutineContext().ensureActive(); verifyPath(dir, true)
+            check(directoryIdentity == identity(dir) && partIdentity == identity(part))
+            // No replacement or non-atomic fallback. Receipt publication precedes entity admission.
+            Files.move(part, path, StandardCopyOption.ATOMIC_MOVE); published = true
+            Files.writeString(receipt(path), "$size\n${hash(path)}\n", StandardOpenOption.CREATE_NEW)
+            FishAudioStoredAudio(path.toString(), duration, size)
+        } finally {
+            // Only this invocation's uniquely created partial file; published artifacts survive errors.
+            if (!published && Files.exists(part, LinkOption.NOFOLLOW_LINKS)) {
+                verifyPath(part, false)
+                if (partIdentity == identity(part) && directoryIdentity == identity(dir)) Files.delete(part)
+            }
+        }
+    } }
+
+    suspend fun verify(raw: String): Path = mutex.withLock { withContext(Dispatchers.IO) { verifyOwned(raw) } }
+
+    suspend fun deleteIfOwned(raw: String): Boolean = mutex.withLock { withContext(Dispatchers.IO) {
+        val path = Path.of(raw).toAbsolutePath().normalize()
+        if (!path.startsWith(root) || path.parent?.parent != root) return@withContext false
+        if (!Files.exists(path, LinkOption.NOFOLLOW_LINKS)) return@withContext !Files.exists(receipt(path))
+        verifyOwned(raw) // Ambiguous identity/hash/receipt fails closed, never deletes external media.
+        Files.delete(path); Files.delete(receipt(path)); true
+    } }
+
+    private fun verifyOwned(raw: String): Path {
+        val path = Path.of(raw)
+        check(path.isAbsolute && path.normalize() == path && path.parent?.parent == root && path.startsWith(root))
+        check(path.fileName.toString().matches(Regex("[a-zA-Z0-9_-]+\\.mp3")))
+        verifyPath(path, false); verifyPath(receipt(path), false)
+        check(Files.size(receipt(path)) < 128)
+        val proof = Files.readAllLines(receipt(path))
+        check(proof.size == 2 && proof[0].toLongOrNull() == Files.size(path) && proof[1] == hash(path)) {
+            "音频身份无法确认；文件已保留"
+        }
+        DesktopMp3Validation.validate(path, limit, 1_800_000)
+        return path
+    }
+    private fun receipt(path: Path) = path.resolveSibling("${path.fileName}.owner")
+    private fun segment(id: String): String {
+        require(id.matches(Regex("[a-zA-Z0-9_-]{1,128}"))) { "音频资源 ID 无效" }; return id
+    }
+    private fun hash(path: Path): String {
+        check(Files.size(path) <= limit)
+        val digest = MessageDigest.getInstance("SHA-256")
+        Files.newInputStream(path, LinkOption.NOFOLLOW_LINKS).use { stream ->
+            val buf = ByteArray(16384); var total = 0L
+            while (true) { val n = stream.read(buf); if (n < 0) break
+                check(n <= limit - total); total += n; digest.update(buf, 0, n) }
+        }
+        return java.util.HexFormat.of().formatHex(digest.digest())
+    }
+    private fun identity(path: Path): Any {
+        val attrs = Files.readAttributes(path, BasicFileAttributes::class.java, LinkOption.NOFOLLOW_LINKS)
+        return if (System.getProperty("os.name").startsWith("Windows"))
+            DesktopIndexStartupPreflight.readWindowsIdentity(path, attrs.isDirectory)
+        else checkNotNull(attrs.fileKey())
+    }
+    private fun ensureDirectory(directory: Path) {
+        verifyPath(dataRoot, true)
+        var current = dataRoot
+        dataRoot.relativize(directory).forEach { name ->
+            current = current.resolve(name)
+            if (!Files.exists(current, LinkOption.NOFOLLOW_LINKS)) Files.createDirectory(current)
+            verifyPath(current, true)
+        }
+    }
+    private fun verifyPath(path: Path, directory: Boolean) {
+        check(path.toRealPath() == path)
+        var current: Path? = path
+        while (current != null) {
+            val attrs = Files.readAttributes(current, BasicFileAttributes::class.java, LinkOption.NOFOLLOW_LINKS)
+            check(!attrs.isSymbolicLink && !attrs.isOther)
+            if (current == path) check(if (directory) attrs.isDirectory else attrs.isRegularFile)
+            current = current.parent
+        }
+    }
+}
