+                assertFalse(parent.isEnabled); assertTrue(other.isEnabled)
+                if (iteration % 2 == 0) { first.close(); assertFalse(parent.isEnabled); second.close() }
+                else { second.close(); assertFalse(parent.isEnabled); first.close() }
